{
  "name": "substratum",
  "version": "0.2.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "pnpm --filter @repo/web dev",
    "build": "pnpm --recursive build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm --recursive typecheck",
    "db:generate": "pnpm --filter @repo/web db:generate",
    "reset-password": "pnpm --filter @repo/web reset-password",
    "migrate:storage": "pnpm --filter @repo/web migrate:storage",
    "seed": "pnpm --filter @repo/web seed",
    "test:unit": "pnpm --filter @repo/web test:unit",
    "test:e2e": "pnpm --filter @repo/web test:e2e",
    "shots": "pnpm --filter @repo/web shots"
  },
  "devDependencies": {
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.3.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
