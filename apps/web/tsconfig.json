{
  "include": ["**/*", "**/.server/**/*", "**/.client/**/*", ".react-router/types/**/*"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    // `test/` is run by node itself, not the bundler, so its imports carry the
    // .ts extension. Safe with noEmit: nothing is rewritten on the way out.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"],
      // Types for the stories next to the components, borrowed from the
      // Storybook app. Not a dependency of web on purpose: `pnpm deploy` builds
      // the production image from web's full dependency tree, and Storybook's
      // tree once broke it. Stories may only `import type` from here; a value
      // import would not resolve when Storybook bundles them.
      "@storybook/react-vite": ["../storybook/node_modules/@storybook/react-vite/dist/index.d.ts"]
    },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  }
}
