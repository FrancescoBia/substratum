{
  "name": "@repo/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "db:generate": "drizzle-kit generate",
    "reset-password": "node ./scripts/reset-password.ts",
    "seed": "node ./scripts/seed.mjs",
    "test:e2e": "node ./scripts/reset-test-data.mjs && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "shots": "node ./scripts/reset-test-data.mjs && playwright test --project=chromium --grep 'capture every view'"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@repo/shared": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.6",
    "isbot": "^5.1.36",
    "lucide-react": "^1.27.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.5",
    "fflate": "^0.8.3",
    "shadcn": "^4.16.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
